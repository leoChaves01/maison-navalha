generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

model Barber {
  id           String        @id @default(cuid())
  name         String
  slug         String        @unique
  specialty    String
  active       Boolean       @default(true)
  appointments Appointment[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Service {
  id           String        @id @default(cuid())
  name         String
  slug         String        @unique
  description  String
  duration     Int
  price        Int
  active       Boolean       @default(true)
  appointments Appointment[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Appointment {
  id          String            @id @default(cuid())
  bookingCode String?           @unique
  clientName  String
  phone       String
  email       String?
  date        String
  time        String
  slotKey     String?           @unique
  status      AppointmentStatus @default(PENDING)
  notes       String?
  barberId    String
  serviceId   String
  barber      Barber            @relation(fields: [barberId], references: [id], onDelete: Restrict)
  service     Service           @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([date])
  @@index([barberId, date])
  @@index([status])
  @@index([phone, bookingCode])
}
